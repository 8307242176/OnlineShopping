<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - PrimeCart Shop</title>

    <link rel="stylesheet" href="~/vendors/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="~/vendors/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/vendors/themify-icons/themify-icons.css">
    <link rel="stylesheet" href="~/vendors/nice-select/nice-select.css">
    <link rel="stylesheet" href="~/vendors/owl-carousel/owl.theme.default.min.css">
    <link rel="stylesheet" href="~/vendors/owl-carousel/owl.carousel.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <script src="https://kit.fontawesome.com/082b9821b0.js" crossorigin="anonymous"></script>

</head>
<body>

    <!-- ================ Start Header Area ================= -->
    <header class="header_area">
        <div class="main_menu">
            <nav class="navbar navbar-expand-lg navbar-light">
                <div class="container">
                    <a class="navbar-brand logo_h"
                       asp-controller="Home" asp-action="Index">
                        <img src="~/img/logo.png" asp-append-version="true" hieght="200" width="200" alt="PrimeCart Shop">
                    </a>
                    <button class="navbar-toggler" type="button"
                            data-toggle="collapse"
                            data-target="#navbarSupportedContent">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>

                    <div class="collapse navbar-collapse"
                         id="navbarSupportedContent">
                        <ul class="nav navbar-nav menu_nav ml-auto mr-auto">
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Product"
                                   asp-action="Index">Shop</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Cart"
                                   asp-action="Index">
                                    <i class="ti-shopping-cart"></i> Cart
                                </a>
                            </li>

                            @if (Context.Session.GetString("UserName") != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Order"
                                       asp-action="MyOrders">My Orders</a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link"
                                          style="color:#888">
                                        Hello, @Context.Session.GetString("UserName")
                                    </span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Account"
                                       asp-action="Logout">Logout</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Account"
                                       asp-action="Login"><i class="fa-solid fa-circle-user"></i>Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Account"
                                       asp-action="Register"><i class="fa-regular fa-user"></i>Register</a>
                                </li>
                            }
                            @if (Context.Session.GetString("UserName") != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        <i class="ti-settings"></i> Admin
                                    </a>
                                </li>
                              
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
    </header>
    <!-- ================ End Header Area ================= -->
    <!-- ===== PAGE CONTENT ===== -->
    <main>
        @RenderBody()
    </main>
    <!-- ===== END CONTENT ===== -->
    <!-- ================ Start Footer Area ================= -->
    <footer class="footer">
        <div class="footer-area">
            <div class="container">
                <div class="row footer_inner">
                    <div class="col-lg-3 col-sm-6">
                        <div class="single-footer-widget tp_widgets">
                            <h4 class="footer_title large_title">PrimeCart Shop</h4>
                            <p>Your one-stop online shopping destination.</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6">
                        <div class="single-footer-widget tp_widgets">
                            <h4 class="footer_title">Quick Links</h4>
                            <ul class="list">
                                <li>
                                    <a asp-controller="Home"
                                       asp-action="Index">Home</a>
                                </li>
                                <li>
                                    <a asp-controller="Product"
                                       asp-action="Index">Shop</a>
                                </li>
                                <li>
                                    <a asp-controller="Account"
                                       asp-action="Login">Login</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6">
                        <div class="single-footer-widget tp_widgets">
                            <h4 class="footer_title">Contact Us</h4>
                            <ul class="list">
                                <li><a href="#">support@PrimeCartshop.com</a></li>
                                <li><a href="#">+91 8307242176</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p class="col-lg-12 footer-text text-center">
                    &copy; @DateTime.Now.Year PrimeCart Shop. All rights reserved.
                </p>
            </div>
        </div>
    </footer>
    <!-- ================ End Footer Area ================= -->

    <script src="~/vendors/jquery/jquery-3.2.1.min.js"></script>
    <script src="~/vendors/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/vendors/owl-carousel/owl.carousel.min.js"></script>
    <script src="~/vendors/nice-select/jquery.nice-select.min.js"></script>
    <script src="~/js/main.js"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
