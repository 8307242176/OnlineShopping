@model OnlineShopping.ViewModel.Login
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ================ start banner area ================= -->
<section style="height=70; position=relative; z-index=1" id="category"
         style="min-height: unset; padding: 90px 0;">
    <div class="container">
        <div class="blog-banner">
            <div class="text-center">
                <h1>Login</h1>
                <nav aria-label="breadcrumb" class="banner-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Login</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- ================ end banner area ================= -->
<!--================ Login Box Area =================-->
<section class="login_box_area section-margin">
    <div class="container">
        <div class="row">

            <!-- Left side image/promo -->
            <div class="col-lg-6">
                <div class="login_box_img">
                    <div class="hover">
                        <h4>New to our website?</h4>
                        <p>Create an account and enjoy a seamless shopping experience with us.</p>
                        <a class="button button-account"
                           asp-controller="Account"
                           asp-action="Register">Create an Account</a>
                    </div>
                </div>
            </div>

            <!-- Right side login form -->
            <div class="col-lg-6">
                <div class="login_form_inner">
                    <h3>Log in to enter</h3>

                    @* Show validation errors *@
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <form class="row login_form"
                          asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="col-md-12 form-group">
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Email Address"
                                   onfocus="this.placeholder=''"
                                   onblur="this.placeholder='Email Address'" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 form-group">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Password"
                                   onfocus="this.placeholder=''"
                                   onblur="this.placeholder='Password'" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 form-group">
                            <button type="submit"
                                    class="button button-login w-100">
                                Log In
                            </button>
                        </div>

                        <div class="col-md-12 form-group text-center">
                            <a asp-controller="Account"
                               asp-action="Register">
                                Don't have an account? Register here
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</section>
<!--================ End Login Box Area =================-->