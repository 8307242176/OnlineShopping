@model IEnumerable<OnlineShopping.Models.Order>
@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ================ Banner Area ================= -->
<section class="blog-banner-area" id="category"
         style="min-height:unset; padding: 30px 0;">
    <div class="container">
        <div class="blog-banner">
            <div class="text-center">
                <h1>My Orders</h1>
                <nav aria-label="breadcrumb" class="banner-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            My Orders
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- ================ End Banner ================= -->

<!--================ Orders Area =================-->
<section class="tracking_box_area section-margin--small">
    <div class="container">

        @if (!Model.Any())
        {
            <!-- No Orders Yet -->
            <div class="tracking_box_inner text-center py-5">
                <i class="ti-package"
                   style="font-size:60px; color:#ccc;"></i>
                <h4 class="mt-3 text-muted">No orders yet!</h4>
                <p class="text-muted">
                    You haven't placed any orders yet.
                </p>
                <a asp-controller="Product"
                   asp-action="Index"
                   class="button button--active mt-3">
                    Start Shopping
                </a>
            </div>
        }
        else
        {
            <!-- Orders List -->
            @foreach (var order in Model)
            {
                <!-- Status Badge Color -->
                
                    var badgeColor = order.Status switch
                    {
                        "Pending"   => "background:#f0ad4e;",
                        "Shipped"   => "background:#5bc0de;",
                        "Delivered" => "background:#5cb85c;",
                        _           => "background:#999;"
                    };
                    
                    

                <div class="tracking_box_inner mb-4"
                     style="border:1px solid #eee;
                            border-radius:8px;
                            padding:25px;">

                    <!-- Order Header -->
                    <div class="d-flex justify-content-between
                                align-items-center mb-3
                                flex-wrap">
                        <div>
                            <h5 class="mb-1">
                                Order
                                <span style="color:#ff3a6e;">
                                    #@order.OrdId
                                </span>
                            </h5>
                            <small class="text-muted">
                                Total:
                                <strong>₹@order.TotalAmount</strong>
                            </small>
                        </div>
                        <div>
                            <span style="@badgeColor
                                         color:#fff;
                                         padding:5px 15px;
                                         border-radius:20px;
                                         font-size:13px;">
                                @order.Status
                            </span>
                        </div>
                    </div>

                    <!-- Order Items Table -->
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead style="background:#f9f9f9;">
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Qty</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.OrderItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (item.Prd?.ProductImages != null &&
                                                                                    item.Prd.ProductImages.Any())
                                                {
                                                    <img src="@(item.Prd.ProductImages.FirstOrDefault()?.ImageUrl ?? "/img/product/default.jpg")"
                                                         style="width:45px;
                                                                height:45px;
                                                                object-fit:cover;
                                                                margin-right:10px;
                                                                border-radius:4px;"
                                                         alt="@item.Prd.PrdName">
                                                }
                                                <span>
                                                    @(item.Prd?.PrdName ?? "Product")
                                                </span>
                                            </div>
                                        </td>
                                        <td>₹@item.Price</td>
                                        <td>@item.Quantity</td>
                                        <td>
                                            ₹@(item.Price * item.Quantity)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3"
                                        class="text-right font-weight-bold">
                                        Grand Total:
                                    </td>
                                    <td class="font-weight-bold"
                                        style="color:#ff3a6e;">
                                        ₹@order.TotalAmount
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Order Footer Buttons -->
                    <div class="d-flex justify-content-between
                                align-items-center mt-3 flex-wrap">

                        <!-- Status Progress Bar -->
                        <div style="flex:1; margin-right:20px;">
                            <div class="d-flex justify-content-between
                                        text-muted mb-1"
                                 style="font-size:12px;">
                                <span>Pending</span>
                                <span>Shipped</span>
                                <span>Delivered</span>
                            </div>
                            <div class="progress"
                                 style="height:6px;">
                                <div class="progress-bar"
                                     style="width:
                                        @(order.Status == "Pending"   ? "20%"  :
                                          order.Status == "Shipped"   ? "60%"  :
                                          order.Status == "Delivered" ? "100%" : "0%");
                                        @badgeColor">
                                </div>
                            </div>
                        </div>

                        <!-- Continue Shopping -->
                        <a asp-controller="Product"
                           asp-action="Index"
                           class="gray_btn mt-2">
                            <i class="ti-shopping-cart"></i>
                            Continue Shopping
                        </a>
                    </div>

                </div>
            }
        }

    </div>
</section>
<!--================ End Orders Area =================-->