@model OnlineShopping.ViewModels.ProductFormVM
@using OnlineShopping.Models
@{
    ViewData["Title"] = "Add Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<Category>;
}

<section style="padding: 40px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card p-4">
                    <h3 class="mb-4">Add New Product</h3>

                    <div asp-validation-summary="All"
                         class="text-danger mb-3"></div>

                    <form asp-action="AddProduct"
                          asp-controller="Admin"
                          method="post">
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label asp-for="PdName">Product Name</label>
                            <input asp-for="PdName"
                                   class="form-control" />
                            <span asp-validation-for="PdName"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Description">Description</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"></textarea>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Price">Price (₹)</label>
                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />
                            <span asp-validation-for="Price"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="CatgId">Category</label>
                            <select asp-for="CatgId"
                                    class="form-control"
                                    id="catgSelect">
                                <option value="">-- Select Category --</option>
                                @if (categories != null)
                                {
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.CatId">
                                            @cat.CatName
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CatgId"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="SCatgId">Sub Category</label>
                            <select asp-for="SCatgId"
                                    class="form-control"
                                    id="sCatgSelect">
                                <option value="">
                                    -- Select Category First --
                                </option>
                            </select>
                            <span asp-validation-for="SCatgId"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ImgUrl">Image URL</label>
                            <input asp-for="ImgUrl"
                                   class="form-control"
                                   placeholder="https://..." />
                            <small class="text-muted">
                                Paste a direct image URL
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="button button--active">
                                Add Product
                            </button>
                            <a asp-controller="Admin"
                               asp-action="Products"
                               class="gray_btn">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('catgSelect')
                .addEventListener('change', function () {
            var catgId = this.value;
            var sCatgSelect = document.getElementById('sCatgSelect');

            sCatgSelect.innerHTML =
                '<option value="">-- Loading... --</option>';

            if (catgId) {
                fetch('/Admin/GetSubCategories?catgId=' + catgId)
                    .then(response => response.json())
                    .then(data => {
                        sCatgSelect.innerHTML =
                            '<option value="">-- Select SubCategory --</option>';
                        data.forEach(function (item) {
                            sCatgSelect.innerHTML +=
                                '<option value="' + item.sCatgId + '">' +
                                item.sCatgName + '</option>';
                        });
                    });
            }
        });
    </script>
}